<configuration>
    <!-- Console-only config for every subcommand inside the Docker image (serve + the one-shot
         CLIs). The launcher selects it when HYDROZOA_LOGBACK=logback-docker.xml (set in build.sbt's
         Docker/dockerEnvVars); local runs default to the verbose, file-writing logback.xml. No file
         appenders: a container must not write hydrozoa.log / hydrozoa-trace.jsonl into its
         filesystem — logs go to stdout, where `docker logs` / the log aggregator collects them.
         Levels are the quiet container defaults (root warn, hydrozoa info), not the per-actor
         `trace` firehose logback.xml uses for local debugging. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{48} - %msg%n</pattern>
        </encoder>
    </appender>
    <root level="warn">
        <appender-ref ref="STDOUT"/>
    </root>
    <logger name="hydrozoa" level="info"/>
    <logger name="com.bloxbean" level="warn"/>
    <logger name="scalus" level="warn"/>
    <logger name="CardanoBackend" level="warn"/>
</configuration>
