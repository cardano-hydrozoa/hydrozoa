<!--
  CI logging for the integration tests (selected by the build when CI is set). Everything down to
  TRACE goes to integration-tests.log, which the CI workflow uploads as a short-lived artifact; the
  console, which GitHub keeps in the job log, gets WARN and above only.
-->
<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{64}) %n%msg%n
            </pattern>
        </encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>integration-tests.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{64} %n%msg%n
            </pattern>
        </encoder>
    </appender>

    <appender name="MERMAID" class="ch.qos.logback.core.FileAppender">
        <file>stage4-peers-interaction.mmd</file>
        <append>false</append>
        <layout class="hydrozoa.integration.MermaidSequenceDiagramLayout">
            <pattern>%msg%n</pattern>
        </layout>
    </appender>
    <logger name="CoilPeerWsTransport" level="warn"/>
    <logger name="CoilJoin" level="info"/>
    <logger name="PeerTransport" level="warn"/>
    <logger name="Mermaid.PeerLiaison" level="info" additivity="false">
    <!-- The only record of why a supervised actor failed; never quiet it. -->
    <logger name="Supervision" level="error"/>
        <appender-ref ref="MERMAID"/>
    </logger>

    <root level="trace">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
